DATABASE_URL=postgresql+psycopg://textsql:textsql@localhost:5433/textsql
# Or your own DB:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/mydb
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/mydb

# Ollama
OLLAMA_HOST=http://localhost:11434
SQL_MODEL=sqlcoder:7b
JUDGE_MODEL=llama3.2

# Safety limits
MAX_ROWS=100
QUERY_TIMEOUT_SEC=30

# Optional comma-separated table allowlist (empty = all tables)
# TABLE_ALLOWLIST=customers,orders,products

# Hallucination judge: block | warn | off
JUDGE_MODE=block
JUDGE_THRESHOLD=0.7
